  "components": [
    {
      "name": "Dashboard card (flat baseline)",
      "kind": "card",
      "refersTo": "dashboard-card",
      "description": "Static visual excerpt of a flat metric card; uses the effective Quasar body stack without requiring Quasar at preview time.",
      "html": "<section class=\"ds-dashboard-card\"><span class=\"ds-metric-label\">HEALTH</span><strong class=\"ds-metric-value\">100%</strong><span class=\"ds-metric-note\">Local fixture value</span></section>",
      "css": ".ds-dashboard-card{color:#18312d;background:rgba(255,255,255,.92);border:1px solid #dfe7e6;border-radius:16px;padding:26px;font-family:Roboto,-apple-system,'Helvetica Neue',Helvetica,Arial,sans-serif;display:flex;flex-direction:column;gap:12px;max-width:260px}.ds-metric-label{color:#71847f;font-size:11px;font-weight:700;letter-spacing:.11em}.ds-metric-value{font-size:28px;font-weight:650;letter-spacing:-.03em}.ds-metric-note{color:#6c7e79;font-size:12px}"
    },
    {
      "name": "Application action",
      "kind": "button",
      "refersTo": "application-button",
      "description": "Visual excerpt of the default application action. Production uses q-btn; theme variables resolve from the enclosing application, with light-theme preview fallbacks.",
      "html": "<button class=\"ds-application-button\" type=\"button\">Run observation</button>",
      "css": ".ds-application-button{position:relative;overflow:hidden;background:var(--ui-primary,#2459a8);color:var(--ui-background,#f7f9fc);border:0;border-radius:3px;padding:4px 16px;min-height:2.572em;font:500 14px/1.715em Roboto,-apple-system,'Helvetica Neue',Helvetica,Arial,sans-serif;cursor:pointer;box-shadow:0 1px 5px #0003,0 2px 2px #00000024,0 3px 1px -2px #0000001f}.ds-application-button::before{content:'';position:absolute;inset:0;background:currentColor;opacity:0;pointer-events:none}.ds-application-button:hover::before{opacity:.15}.ds-application-button:active::before{opacity:.3}.ds-application-button:focus-visible{outline:3px solid var(--ui-accent,#00796b);outline-offset:3px}.ds-application-button:disabled{opacity:.7;cursor:default}"
    },
    {
      "name": "Review control",
      "kind": "button",
      "refersTo": "review-control",
      "description": "Native outlined review button. Its browser focus behavior is represented with outline:auto; no custom hover color exists in the source.",
      "html": "<button class=\"ds-review-control\" type=\"button\">Refresh rounds</button>",
      "css": ".ds-review-control{padding:8px;color:inherit;background:transparent;border:1px solid #70999d;border-radius:4px;cursor:pointer}.ds-review-control:hover{cursor:pointer}.ds-review-control:focus-visible{outline:auto}.ds-review-control:disabled{opacity:.55;cursor:default}"
    },
    {
      "name": "Review source editor",
      "kind": "input",
      "refersTo": "review-editor",
      "description": "Dark native source textarea excerpt; preview height is reduced from the production 55vh/minimum 280px to keep the swatch compact.",
      "html": "<label class=\"ds-editor-label\">Candidate proposal JSON<textarea class=\"ds-review-editor\" rows=\"6\" spellcheck=\"false\">{\n  \"revision\": \"r1\"\n}</textarea></label>",
      "css": ".ds-editor-label{display:grid;gap:6px;color:#18312d;font:14px/1.5 system-ui,sans-serif}.ds-review-editor{max-width:100%;margin-top:12px;padding:12px;color:#edf7f7;background:#10272a;border:1px solid #70999d;font-family:monospace}.ds-review-editor:focus-visible{outline:auto}"
    },
    {
      "name": "Review text field",
      "kind": "input",
      "refersTo": "review-input",
      "description": "Native labeled review input; browser focus behavior, no invented hover treatment.",
      "html": "<label class=\"ds-review-label\">Stage title<input class=\"ds-review-input\" value=\"Ontology review\" /></label>",
      "css": ".ds-review-label{display:grid;gap:6px;min-width:160px;color:#18312d;font:14px/1.5 system-ui,sans-serif}.ds-review-input{padding:8px;color:inherit;background:transparent;border:1px solid #70999d;border-radius:4px}.ds-review-input:focus-visible{outline:auto}"
    },
    {
      "name": "Service navigation",
      "kind": "nav",
