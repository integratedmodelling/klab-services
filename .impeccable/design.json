      "html": "<nav class=\"ds-service-nav\" aria-label=\"Service links\"><a href=\"#review\" class=\"ds-service-active\" aria-current=\"page\">Review</a><a href=\"#workflows\">Workflows</a></nav>",
      "css": ".ds-service-nav{display:flex;gap:22px;font:13px/1.5 Roboto,-apple-system,\"Helvetica Neue\",Helvetica,Arial,sans-serif}.ds-service-nav a{color:#5d716d;text-decoration:none}.ds-service-nav a:hover{color:#18312d}.ds-service-nav .ds-service-active{color:#24735f}.ds-service-nav a:focus-visible{outline:auto}"
    },
