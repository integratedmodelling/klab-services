      "css": ".ds-permission-chip{display:inline-flex;align-items:center;max-width:100%;height:1.5em;margin:4px;padding:0 .4em;border-radius:12px;background:#00695c;color:#e0f2f1;white-space:nowrap;font:14px/1.5 Roboto,-apple-system,\"Helvetica Neue\",Helvetica,Arial,sans-serif}"
    }
