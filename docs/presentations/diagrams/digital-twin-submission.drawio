        <mxCell id="title" value="Submission: from pending work to accepted knowledge" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#18334B;fontFamily=Arial;fontSize=39;align=left;verticalAlign=middle;spacing=20;fontStyle=1;" vertex="1" parent="1">
