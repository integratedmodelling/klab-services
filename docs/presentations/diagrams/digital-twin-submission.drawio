<mxfile host="app.diagrams.net" type="device">
  <diagram id="digital-twin-submission" name="Submission: from pending work to accepted knowledge">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF">
      <root>
