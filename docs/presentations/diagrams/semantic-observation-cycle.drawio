        <mxCell id="legend" value="Dashed arrows: a new observation request. Existing suitable observations may be reused." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#18334B;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=middle;spacing=20;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1520" height="55" as="geometry" />
