              <mxPoint x="1300" y="295" />
              <mxPoint x="300" y="295" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="transaction" value="&lt;b&gt;TRANSACTIONAL ACCEPTANCE&lt;/b&gt;&lt;br&gt;Semantic changes and their provenance become accepted together." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2D9;strokeColor=#C4D2DB;fontColor=#18334B;fontFamily=Arial;fontSize=25;align=left;verticalAlign=middle;spacing=20;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="1400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="consequence" value="&lt;b&gt;AFTER COMMIT&lt;/b&gt;  Consequence assessment can request further observations." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#C4D2DB;fontColor=#18334B;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="720" width="1400" height="65" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Meaning, values and producing activities stay linked as the observed system evolves." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#18334B;fontFamily=Arial;fontSize=20;align=left;verticalAlign=middle;spacing=20;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="845" width="1520" height="45" as="geometry" />
