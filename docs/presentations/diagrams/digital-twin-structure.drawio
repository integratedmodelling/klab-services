<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="digital-twin-structure" name="Live observations: inside a digital twin">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Live observations: inside a digital twin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#18334B;fontFamily=Arial;fontSize=39;align=left;verticalAlign=middle;spacing=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Three core components share observation identity, context and a traceable history." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#18334B;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#C4D2DB;fontColor=#18334B;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="185" width="1520" height="640" as="geometry" />
        </mxCell>
        <mxCell id="context" value="&lt;b&gt;DIGITAL TWIN&lt;/b&gt;  Observer · entities · space · time · scenario" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#18334B;fontFamily=Arial;fontSize=25;align=left;verticalAlign=middle;spacing=20;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="1440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="graph" value="&lt;b&gt;1  KNOWLEDGE GRAPH&lt;/b&gt;&lt;br&gt;&lt;br&gt;Individual observations&lt;br&gt;Bearers and participants&lt;br&gt;Dependencies and provenance" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#C4D2DB;fontColor=#18334B;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="335" width="400" height="225" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="&lt;b&gt;2  DATA STORAGE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Values tied to observations&lt;br&gt;Spatial fields and time slices&lt;br&gt;References retained in the graph" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#C4D2DB;fontColor=#18334B;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="335" width="400" height="225" as="geometry" />
        </mxCell>
        <mxCell id="scheduler" value="&lt;b&gt;3  SCHEDULER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Executable methods&lt;br&gt;Dependency order&lt;br&gt;Relevant time transitions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#C4D2DB;fontColor=#18334B;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1100" y="335" width="400" height="225" as="geometry" />
        </mxCell>
        <mxCell id="values" value="links" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#52667A;strokeWidth=3;endArrow=block;endFill=1;fontColor=#18334B;fontFamily=Arial;fontSize=20;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="graph" target="storage" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="io" value="values" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#52667A;strokeWidth=3;endArrow=block;endFill=1;fontColor=#18334B;fontFamily=Arial;fontSize=20;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="scheduler" target="storage" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="plans + dependencies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#52667A;strokeWidth=3;endArrow=block;endFill=1;fontColor=#18334B;fontFamily=Arial;fontSize=20;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" source="scheduler" target="graph" parent="1">
          <mxGeometry relative="1" as="geometry">
