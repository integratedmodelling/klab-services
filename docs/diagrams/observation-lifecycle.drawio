        <mxCell id="bind" value="&lt;b&gt;3  Compile and bind&lt;/b&gt;&lt;br&gt;Actual targets, aliases, executors and native input plans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#237C68;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="135" width="250" height="120" />
        </mxCell>
        <mxCell id="execute" value="&lt;b&gt;4  Contextualize&lt;/b&gt;&lt;br&gt;Prerequisites, scientific work and required follow-ups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#237C68;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="335" width="250" height="120" />
        </mxCell>
        <mxCell id="commit" value="&lt;b&gt;5  Validate and publish&lt;/b&gt;&lt;br&gt;Original read sets, receipts, cancellation; atomic root commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D7;strokeColor=#A67417;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="335" width="250" height="120" />
