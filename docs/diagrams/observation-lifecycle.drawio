        <mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="request" target="resolve" parent="1">
