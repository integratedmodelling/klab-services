        <mxCell id="edge6" value="activation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="commit" target="simulation" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="notes" value="RESOLVED describes a plan; actual execution or certified reuse establishes scientific completion.&lt;br&gt;NO_MODEL is valid only under the relevant lifecycle policy. Unknown evidence stays DEFERRED.&lt;br&gt;Child success remains pending until root publication. Failed uncommitted work rolls back.&lt;br&gt;Dashed arrows: post-commit activation. Later independent failure does not undo an earlier commit." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#526376;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="737" width="1120" height="92" />
        </mxCell>
      </root>
