        <mxCell id="edge5" value="after commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="commit" target="consequence" parent="1">
          <mxGeometry as="geometry" relative="1" />
