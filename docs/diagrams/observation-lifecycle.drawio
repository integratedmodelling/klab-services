        <mxCell id="edge3" value="staged work" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="execute" target="commit" parent="1">
          <mxGeometry as="geometry" relative="1" />
