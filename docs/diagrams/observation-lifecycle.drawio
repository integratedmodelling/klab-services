        </mxCell>
        <mxCell id="resolve" value="&lt;b&gt;2  Resolve and admit&lt;/b&gt;&lt;br&gt;Reuse, strategies, candidate gates and dependency coverage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#386CB0;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
