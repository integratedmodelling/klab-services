        <mxCell id="result" value="&lt;b&gt;6  Committed result&lt;/b&gt;&lt;br&gt;Interpret outcome and support for the requested operation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#237C68;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="335" width="250" height="120" />
        </mxCell>
        <mxCell id="consequence" value="&lt;b&gt;Automatic consequences&lt;/b&gt;&lt;br&gt;Assess relevant changes; resolve and commit causal work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECFA;strokeColor=#7352A0;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="250" y="565" width="250" height="120" />
