          <mxGeometry as="geometry" x="35" y="20" width="1120" height="38" />
        </mxCell>
        <mxCell id="subtitle" value="One owning Runtime / Resolver workflow; one retained observer and semantic actor per cycle." style="text;html=1;align=left;fontSize=15;fontColor=#526376;whiteSpace=wrap;" vertex="1" parent="1">
