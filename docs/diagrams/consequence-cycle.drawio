<mxfile host="app.diagrams.net" version="29.0.0">
  <diagram id="consequence-cycle" name="Commit, consequence assessment and cycle drain">
    <mxGraphModel adaptiveColors="auto" dx="1200" dy="860" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="860" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Commit, consequence assessment and cycle drain" style="text;html=1;align=left;fontSize=26;fontStyle=1;fontColor=#172D45;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="20" width="1120" height="38" />
        </mxCell>
        <mxCell id="subtitle" value="Consequences preserve the cycle observer, semantic actor and causal chain; each effect uses a guarded transaction." style="text;html=1;align=left;fontSize=15;fontColor=#526376;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="66" width="1120" height="40" />
        </mxCell>
        <mxCell id="commit" value="&lt;b&gt;Successful root commit&lt;/b&gt;&lt;br&gt;Publish changes first; release the transaction graph monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#237C68;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="135" width="250" height="120" />
        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;Queue the commit&lt;/b&gt;&lt;br&gt;Detached summary and cycle ownership; no recursive Java call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECFA;strokeColor=#7352A0;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="135" width="250" height="120" />
        </mxCell>
        <mxCell id="filter" value="&lt;b&gt;Check native relevance&lt;/b&gt;&lt;br&gt;Skip impossible categories before expensive assessment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D7;strokeColor=#A67417;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="135" width="250" height="120" />
        </mxCell>
        <mxCell id="assess" value="&lt;b&gt;Assess the consequence&lt;/b&gt;&lt;br&gt;Rules, native evidence, currentness, support and observer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECFA;strokeColor=#7352A0;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="335" width="250" height="120" />
        </mxCell>
        <mxCell id="submit" value="&lt;b&gt;Resolve optional work&lt;/b&gt;&lt;br&gt;Normal admission and scientific execution; required inputs stay required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#237C68;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="335" width="250" height="120" />
        </mxCell>
        <mxCell id="newcommit" value="&lt;b&gt;Commit causal effects&lt;/b&gt;&lt;br&gt;New guarded root commit; immutable triggering provenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#237C68;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="335" width="250" height="120" />
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;Record the decision&lt;/b&gt;&lt;br&gt;APPLIED, NO_ACTION, DEFERRED or FAILED with evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#84909D;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="565" width="250" height="120" />
        </mxCell>
        <mxCell id="drain" value="&lt;b&gt;Drain the cycle&lt;/b&gt;&lt;br&gt;Complete causal work; then admit the next explicit request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECFA;strokeColor=#7352A0;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="565" width="250" height="120" />
        </mxCell>
        <mxCell id="edge0" value="after publication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="commit" target="queue" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="queue" target="filter" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="relevant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="filter" target="assess" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" value="work justified" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="assess" target="submit" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge4" value="successful work" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="submit" target="newcommit" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge5" value="next queued pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="newcommit" target="queue" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge6" value="no work" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="assess" target="decision" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge7" value="outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="submit" target="decision" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge8" value="APPLIED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="newcommit" target="decision" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="decision" target="drain" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="notes" value="UNCERTAINTY applies to qualities; a substantial observer alone does not justify its assessment.&lt;br&gt;A compatible process already affecting a quality can satisfy CHANGE without another request.&lt;br&gt;Optionality permits genuine NO_MODEL; it does not convert failed inputs into successful work.&lt;br&gt;Dashed arrow: another queued pass in the same cycle. The queue is in-memory, not durable crash replay." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#526376;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="737" width="1120" height="92" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>