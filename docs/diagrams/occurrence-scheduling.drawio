<mxfile host="app.diagrams.net" version="29.0.0">
  <diagram id="occurrence-scheduling" name="Processes, event instantiators and individual events">
    <mxGraphModel adaptiveColors="auto" dx="1200" dy="860" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="860" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Processes, event instantiators and individual events" style="text;html=1;align=left;fontSize=26;fontStyle=1;fontColor=#172D45;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="20" width="1120" height="38" />
        </mxCell>
        <mxCell id="subtitle" value="Implemented dispatch contract. Event end-to-end acceptance remains a separate verification boundary." style="text;html=1;align=left;fontSize=15;fontColor=#526376;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="66" width="1120" height="40" />
        </mxCell>
        <mxCell id="plan" value="&lt;b&gt;Resolve occurrence plans&lt;/b&gt;&lt;br&gt;Admit implementations, native effects, dependencies and execution roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#386CB0;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="135" width="250" height="120" />
        </mxCell>
        <mxCell id="schedule" value="&lt;b&gt;Negotiate cadence&lt;/b&gt;&lt;br&gt;Explicit schedule and locks; otherwise the supported geometry default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D7;strokeColor=#A67417;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="135" width="250" height="120" />
        </mxCell>
        <mxCell id="register" value="&lt;b&gt;Publish registration&lt;/b&gt;&lt;br&gt;Commit accepted plans; temporal work does not execute under INIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#237C68;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="135" width="250" height="120" />
        </mxCell>
        <mxCell id="process" value="&lt;b&gt;Process SIMULATION&lt;/b&gt;&lt;br&gt;Execute at the end of each accepted interval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECFA;strokeColor=#7352A0;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="335" width="250" height="120" />
        </mxCell>
        <mxCell id="instantiate" value="&lt;b&gt;Event instantiation&lt;/b&gt;&lt;br&gt;Execute at interval start; validate zero or more individual events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECFA;strokeColor=#7352A0;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="335" width="250" height="120" />
        </mxCell>
        <mxCell id="individual" value="&lt;b&gt;Prepare each individual&lt;/b&gt;&lt;br&gt;Ordinary child resolution and dependencies; retain bounded event period" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#386CB0;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="335" width="250" height="120" />
        </mxCell>
        <mxCell id="effects" value="&lt;b&gt;Commit transition&lt;/b&gt;&lt;br&gt;Fresh transaction; values, native effects and durable progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#237C68;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="565" width="250" height="120" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;Individual START&lt;/b&gt;&lt;br&gt;Contextualize at start time; publish start effects and visible duration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECFA;strokeColor=#7352A0;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="565" width="250" height="120" />
        </mxCell>
        <mxCell id="end" value="&lt;b&gt;Individual END&lt;/b&gt;&lt;br&gt;Contextualize at end time; publish end effects and completion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECFA;strokeColor=#7352A0;strokeWidth=2;fontColor=#172D45;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="565" width="250" height="120" />
        </mxCell>
        <mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="plan" target="schedule" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="schedule" target="register" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="register" target="process" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" value="event instantiator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="register" target="instantiate" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="process" target="effects" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge5" value="validated batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="instantiate" target="individual" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge6" value="start due" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="individual" target="start" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge7" value="end due" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5B6E80;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" source="start" target="end" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="notes" value="Process cadence defaults to context geometry; event-instantiator cadence defaults to the observer&amp;#x27;s PERCEIVES geometry.&lt;br&gt;Individual plans are prepared on submission. Their computations wait for START and END; event duration stays positive.&lt;br&gt;The due queue is rebuilt after commits so new events can enter before the next regular tick.&lt;br&gt;The diagram describes code paths, not a completed full-stack event test. Real-time driving remains unsupported." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#526376;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="737" width="1120" height="92" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>