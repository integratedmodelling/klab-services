            <id>ossrh</id>
            <url>https://ossrh-staging-api.central.sonatype.com/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <properties>
        <klab.version>1.0.0-SNAPSHOT</klab.version>

        <project.build.sourceEncoding>utf-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>utf-8</project.reporting.outputEncoding>
        <java.version>21</java.version>
        <!-- Careful here: geotools must be right for hortonmachine to work; JTS
            should be the same one that geotools and HM needs. -->
        <geotools.version>34.0</geotools.version>
		<!--<groovy.version>4.0.15</groovy.version>-->
        <jts.version>1.20.0</jts.version>
        <h2gis.version>2.1.214</h2gis.version>
        <netty.version>4.2.6.Final</netty.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <tycho-version>2.7.3</tycho-version>
        <xtextVersion>2.27.0</xtextVersion>
        <mweVersion>2.13.0</mweVersion>
        <googleJibVersion>3.3.1</googleJibVersion>
        <jib.jvmFlags>-XshowSettings:vm</jib.jvmFlags>
        <avro.version>1.12.0</avro.version>
        <nitrite.version>4.3.2</nitrite.version>

        <!-- the five below go together. Never change one without checking the
            others. -->
        <spring-boot.version>3.4.4</spring-boot.version>
        <spring.version>6.2.5</spring.version>
        <spring-security.version>6.4.4</spring-security.version>
        <junit-version>5.6.3</junit-version>
        <javax.mail-api.version>1.5.2</javax.mail-api.version>
        <maven-compiler-plugin-version>3.13.0</maven-compiler-plugin-version>

        <!-- latest tentative -->
        <!-- 1) JUnit -->
        <junit.version>5.11.4</junit.version>
        <!-- 2) Jackson -->
        <jackson.version>2.20.2</jackson.version>

        <!-- 3) Groovy -->
        <groovy.version>4.0.26</groovy.version>
        <!-- 4) RDF4J (align everything; 4.3.16 is latest in 4.3.x series) -->
        <rdf4j.version>4.3.16</rdf4j.version>
        <!-- 5) JAXB (Jakarta line) -->
        <jaxb.version>4.0.5</jaxb.version>
        <checkerframework.version>3.49.3</checkerframework.version>
        <unit-api.version>2.2</unit-api.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin-version}</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <compilerArgs>
                            <arg>-J-Duser.language=en_us</arg>
                            <arg>-g</arg>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.1</version>
                    <configuration>
                        <!-- Recover doclint checks: https://integratedmodelling.atlassian.net/browse/IM-229 !-->
                        <doclint>none</doclint>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${googleJibVersion}</version>
                </plugin>
    			<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>3.0.0-M3</version>
					<configuration>
						<rules>
							<dependencyConvergence />
						</rules>
					</configuration>
				</plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- This makes build info available downstream. Used in klab.distribution to find the ${scmBranch}. Also
                 creates a build number, not used at the moment. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>create</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <!-- https://central.sonatype.org/publish/publish-portal-snapshots/#consuming-snapshot-releases-for-your-project -->
        <repository>
            <name>Central Portal Snapshots</name>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <!-- Old one -->
        <repository>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <id>sonatype-nexus-snapshots</id>
            <name>Maven Central snapshots</name>
            <url>https://oss.sonatype.org/content/repositories/snapshots</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <name>Central Portal Snapshots</name>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>sonatype-nexus-snapshots</id>
            <name>Maven Central snapshots</name>
            <url>https://oss.sonatype.org/content/repositories/snapshots</url>
            <releases>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

