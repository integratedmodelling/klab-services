<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--    <parent>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>klab-services</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </parent>-->

    <artifactId>klab.lsp</artifactId>
    <groupId>org.integratedmodelling</groupId>
    <version>1.0.0-SNAPSHOT</version>
    <description>LSP server for the 4 k.LAB languages, wrapping the xText services.</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <klab.languages.version>1.0.0-SNAPSHOT</klab.languages.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <xtextVersion>2.32.0</xtextVersion>
        <googleJibVersion>3.3.1</googleJibVersion>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>org.integratedmodelling.languages.observable</artifactId>
            <version>${klab.languages.version}</version>
        </dependency>
        <dependency>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>org.integratedmodelling.languages.observable.ide</artifactId>
            <version>${klab.languages.version}</version>

            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>

        </dependency>
        <dependency>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>org.integratedmodelling.languages.worldview</artifactId>
            <version>${klab.languages.version}</version>
        </dependency>
        <dependency>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>org.integratedmodelling.languages.worldview.ide</artifactId>
            <version>${klab.languages.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.eclipse.xtext</groupId>
            <artifactId>org.eclipse.xtext.ide</artifactId>
            <version>${xtextVersion}</version>
        </dependency>
        <!-- possible needed dependencies
        <dependency>
            <groupId>org.eclipse.xtext</groupId>
            <artifactId>org.eclipse.xtext</artifactId>
            <version>${xtextVersion}</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.xtext</groupId>
            <artifactId>org.eclipse.xtext.xbase</artifactId>
            <version>${xtextVersion}</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.xtext</groupId>
            <artifactId>org.eclipse.xtext.xbase.ide</artifactId>
            <version>${xtextVersion}</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.xtext</groupId>
            <artifactId>org.eclipse.xtext.common.types</artifactId>
            <version>${xtextVersion}</version>
        </dependency>
        -->
        <dependency>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>org.integratedmodelling.languages.kim</artifactId>
            <version>${klab.languages.version}</version>
        </dependency>
        <dependency>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>org.integratedmodelling.languages.kim.ide</artifactId>
            <version>${klab.languages.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>org.integratedmodelling.languages.observation</artifactId>
            <version>${klab.languages.version}</version>
        </dependency>
        <dependency>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>org.integratedmodelling.languages.observation.ide</artifactId>
            <version>${klab.languages.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>org.integratedmodelling.languages.kactors</artifactId>
            <version>${klab.languages.version}</version>
        </dependency>
        <dependency>
            <groupId>org.integratedmodelling</groupId>
            <artifactId>org.integratedmodelling.languages.kactors.ide</artifactId>
            <version>${klab.languages.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j</artifactId>
            <version>0.21.0</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j.jsonrpc</artifactId>
            <version>0.21.0</version>
        </dependency>
        <!-- The observable.ide transitive dependency for org.eclipse.emf.ecore is an Eclipse
             feature descriptor (no Java classes), not the actual plugin. Add the real artifact
             explicitly so that ResourceImpl and other EMF classes are present at runtime. -->
        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.ecore</artifactId>
            <version>2.36.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>${googleJibVersion}</version>
                <configuration>
                    <!-- we don't want jib to execute on this module -->
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.integratedmodelling</groupId>
                <artifactId>klab.product</artifactId>
                <version>1.0.1-SNAPSHOT</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>package-release</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <outputDirectory>target/build</outputDirectory>
                    <productName>klab.lsp</productName>
                    <productClass>LANGUAGE_SERVER</productClass>
                    <javaOptions>-Dxtext.disable.standalone.setup=true</javaOptions>
                    <productMain>org.eclipse.xtext.ide.server.ServerLauncher</productMain>
                    <productDescription>LSP service for the k.IM, k.Actors, k.Observation and k.Worldview languages
                    </productDescription>
                    <componentClass/>
                    <componentDescription/>
                    <componentLicenseName/>
                    <componentName/>
                    <componentUsageRights/>
                    <componentVendorEmail/>
                    <componentVendorName/>
                    <distributionName/>
                    <distributionVersion/>
                    <releaseName/>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <!-- https://central.sonatype.org/publish/publish-portal-snapshots/#consuming-snapshot-releases-for-your-project -->
        <repository>
            <name>Central Portal Snapshots</name>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <name>Central Portal Snapshots</name>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>