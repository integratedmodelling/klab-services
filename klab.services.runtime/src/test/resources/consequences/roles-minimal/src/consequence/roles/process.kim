private namespace consequence.roles.process version 1.0;

model imod:Bearer observing imod:Birth;

@time(step=1.month)
model imod:Birth
    observing imod:Input in m named input
    set input to [input];

private model 0 as imod:Input in m;
private model 7 as imod:ImpliedValue in m;

// There is deliberately no model for imod:Marked in its bearer. The inherited
// role and its implied quality must be available before optional characterization.

