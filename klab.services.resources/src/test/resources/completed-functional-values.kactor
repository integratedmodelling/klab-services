behavior test.completed.functional.values
    "Exercise every functional value source exposed by the grammar."
    version 1.0

action init:
    def state 0

action identity(item):
    return item

action assign_values(input):
    expression_value <- [input + 1]
    deferred_expression <- `[input + 2]
    verb_value <- identity(input)
    switch_value <- switch input (
        1 -> yield 10
        # -> yield 20
    )
    return switch_value

action set_values(input):
    set state identity(input)
    set state switch input (
        1 -> yield 11
        # -> yield 22
    )

action fire_values(input):
    fire [input + 1]
    fire identity(input)
    fire switch input (
        1 -> yield 12
        # -> yield 23
    )

action return_values(input):
    return switch input (
        1 -> yield identity(input)
        # -> yield switch input (
            2 -> yield [input + 20]
            # -> yield 30
        )
    )

action ternary_values(condition, input):
    return condition ? identity(input) : switch input (
        1 -> yield [input + 100]
        # -> yield 200
    )

action constant_value:
    return MESSAGES.HELLO

@handle(MESSAGES.HELLO)
action dotted_message(message):
    return message
