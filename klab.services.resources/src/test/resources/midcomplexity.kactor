behavior test.main
    "Description"
	version 1.0
	// should have `inherits` for other behaviors - inits should be chained;
	// `library` only prevents an incomplete behavior from being usable
	using
		core.timer as timer, // enable core.* and maybe make it default?
		core.console as console,
		core.context as context,
		core.strings as strings

// constructor. Not mandatory. Any parameters will be matched to args of `new`.
// `library` should NOT have init or main
action init:
	// global agent state. Set current value; only initializations admitted. `def`
	// should not be available outside init.
	def hostia "hostiatza"

// simplest verb call with double event binding, one internal, one external
action main:
	// a supplier. In Java, that's signaled by returning a CompletableFuture. In k.Actors, use
	// return and never call fire. The listener is unloaded after the future completes.
	timer.in(15.s):
		time -> console.format("Sono le %s", time)
	// emitter, defined below.
	emitter:
		sentence -> console.format("Emitter said %s", sentence)
	// no return or we end before anything happens

// an emitter (fires periodically, no return, continues firing)
action emitter:
    timer.random(step=10.s): time -> (
		// send a can message to all humans with this same behavior. Verb requires parentheses to avoid
		// confusion with an identifier.
		for agent in context.agents(semantics={{any society:HumanIndividual}}, behaviors="test.main")
			agent.send(hostia): response -> console.format("Cazzo ha detto, %s?", response)
		then fire "dio pollo"
	)

@handle(class=can) // FIXME needs to admit constants. Can use global variables as payload
action tiraostia:
	// supply the current value of hostia as a response
	return strings.format("HOSTIA: %s", hostia)
