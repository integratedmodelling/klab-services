behavior test.switch.assignment
    "Exercise a functional switch used as an assignment value."
    version 1.0
    using
        core.console as console,
        core.source as source

action input(message):
    console.format("Received message: %s\n", message)
    x <- switch message (
        "hola" -> (
            console.println("You said HOLA!")
            yield 1
        )
        * -> (
            console.println("Message is different")
            yield 2
        )
    )
    console.format("Result is %d", x)

action match_cases:
    source.read: (
        @selected as selected -> console.println(selected)
        empty -> console.println("empty")
        exception as error -> console.println(error)
        * -> console.println("truthy")
        # -> console.println("anything")
    )
