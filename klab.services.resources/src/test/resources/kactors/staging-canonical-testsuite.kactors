@test(name="Conjunctive selection across independent role families")
action select_two_role_families:
    // selectioncheck also requires the current versioned semantic-content certificate.
    ctx <- context.new
    region <- ctx.submit(ruaha !observer)
    support <- region.geometry
    selected <- ctx.submit({{each agency:Patient imod:Reference earth:Region}}, support :within region
        :namespace "staging.vxii.test.selection" :project "klab.staging.vxii")
    selection <- ctx.focus(:within region)
    assert inspector.selectioncheck(selection, selected, {{each agency:Patient imod:Reference earth:Region}})
    before <- inspector.nativesnapshot(selection)
    repeated <- ctx.submit({{each agency:Patient imod:Reference earth:Region}}, support :within region
        :namespace "staging.vxii.test.selection" :project "klab.staging.vxii")
    assert inspector.selectioncheck(selection, repeated, {{each agency:Patient imod:Reference earth:Region}})
    assert inspector.nativeunchanged(selection, before)

@test(name="Conjunctive selection across four predicate families")
action select_multiple_families:
    ctx <- context.new
    region <- ctx.submit(ruaha !observer)
    support <- region.geometry
    selected <- ctx.submit({{each geography:African earth:Terrestrial agency:Appropriate agency:Patient earth:Region}},
        support :within region :namespace "staging.vxii.test.selection" :project "klab.staging.vxii")
    selection <- ctx.focus(:within region)
